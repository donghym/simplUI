{
  "name": "simplui",
  "private": true,
  "version": "0.1.0",
  "description": "simplUI - copy-paste React component library",
  "scripts": {
    "build": "pnpm sync:templates && pnpm --filter ./packages/cli build",
    "typecheck": "tsc --noEmit -p packages/ui/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sync:templates": "tsx scripts/sync-templates.ts",
    "docs:dev": "pnpm --filter @simplui/docs dev",
    "docs:build": "pnpm --filter @simplui/docs build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-virtuoso": "^4.18.7",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.12.0",
    "@typescript-eslint/parser": "^8.12.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "eslint": "^9.13.0",
    "fs-extra": "^11.2.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0"
  }
}
